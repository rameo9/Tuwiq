# SQLite database file lives next to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# HS256 signing secret — use a long random string in production (32+ chars)
JWT_SECRET="replace-with-a-long-random-secret"

# First admin created by prisma db seed (required)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="minimum-8-chars-change-me"

# اختياري: مسار مطلق لتخزين المرفوعات (يُنصح به إن كان PM2 يعمل من cwd مختلف)
# UPLOAD_DIR=/var/www/saqraljazera/public/uploads

# عنوان الموقع العام — اختياري (للمعاينة عند المشاركة)
# الملف: /var/www/saqraljazera/.env  ثم: npm run build && pm2 restart tuwiq --update-env
SITE_URL="https://tuwaiqapex.com"
NEXT_PUBLIC_SITE_URL="https://tuwaiqapex.com"
